#!/bin/sh

# `moon check` and `moon test` are also what `.github/workflows/ci.yml` runs,
# with `moon build` in between; the formatting gate below is deliberately kept
# out of CI and lives only here. Keep the shared steps in the same order
# whenever either list changes.
#
# Stop at the first failing check: without this, a failing `moon check` would
# be masked by a passing `moon test`, and the commit would go through.
set -e

moon check

# The formatting check looks at the whole project rather than at the staged
# files, so the offending file may be one this commit never touched. Say how to
# fix it, because the diff it prints reads like a problem with the commit.
if ! moon fmt --check; then
  echo "pre-commit: run 'moon fmt' at the repository root and stage the result." >&2
  exit 1
fi

moon test
