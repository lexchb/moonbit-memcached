#!/bin/sh

# These are the first three steps of `.github/workflows/ci.yml`, which adds
# `moon build` on top of them: keep the two lists in the same order whenever
# either one changes.
#
# Stop at the first failing check: without this, a failing `moon check` would
# be masked by a passing `moon test`, and the commit would go through.
set -e

moon check
moon fmt --check
moon test
